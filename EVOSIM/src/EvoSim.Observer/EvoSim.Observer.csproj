<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>EVOSIM</AssemblyName>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../EvoSim.Core/EvoSim.Core.csproj" /></ItemGroup>
  <ItemGroup><Content Include="../../assets/*.bgra" Link="assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
</Project>
